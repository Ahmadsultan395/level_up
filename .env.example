# MongoDB
# Local: mongodb://127.0.0.1:27017/digital-agency
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/digital-agency
MONGODB_URI=mongodb://127.0.0.1:27017/digital-agency

# Auth
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES_IN=7d
COOKIE_NAME=agency_admin_token

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="Sky Way"

# First-run admin seed (used by `npm run seed`)
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
